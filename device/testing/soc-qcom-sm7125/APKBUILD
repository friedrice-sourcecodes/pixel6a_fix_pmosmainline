# Co-Maintainer: Stefan Hansson <newbyte@postmarketos.org>
maintainer="Erikas Bitovtas <xerikasxx@gmail.com>"
pkgname=soc-qcom-sm7125
pkgver=7
pkgrel=0
pkgdesc="Common package for Qualcomm SM7125 devices"
url="https://postmarketos.org"
license="BSD-3-Clause"
arch="aarch64"
options="!check !archcheck !tracedeps"
depends="
	bootmac
	msm-modem
	msm-modem-uim-selection
	tqftpserv
"
install="$pkgname-openrc.post-install"
subpackages="
	$pkgname-openrc
	$pkgname-ucm
	"
replaces="soc-qcom-sm7125-nonfree-firmware"
_ucm_commit="a34eab049098b78ac5f586b11d93060046da3247"
source="
	30-gpu-firmware.files
	alsa-ucm-conf-$_ucm_commit.tar.gz::https://github.com/sm7125-mainline/alsa-ucm-conf/archive/$_ucm_commit/alsa-ucm-conf-$_ucm_commit.tar.gz
	UPower.conf
"

package() {
	# Shutdown when battery is critical instead of sleep
	install -Dm644 "$srcdir"/UPower.conf \
		"$pkgdir"/etc/UPower/UPower.conf.d/50-sm7125.conf

	install -Dm644 "$srcdir"/30-gpu-firmware.files \
		"$pkgdir"/usr/share/mkinitfs/files/30-gpu-firmware.files
}

openrc() {
	default_openrc
	depends="tqftpserv-openrc"

	mkdir -p "$subpkgdir"
}

ucm() {
	provides="alsa-ucm-conf=0.$pkgver-r$pkgrel" # versioned provides need to be below default version

	# install audio config files
	mkdir -p "$subpkgdir"/usr/share/alsa/ucm2
	cp -r "$srcdir/alsa-ucm-conf-$_ucm_commit"/ucm2 "$subpkgdir"/usr/share/alsa/
}

sha512sums="
