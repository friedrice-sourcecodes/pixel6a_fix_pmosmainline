diff --git a/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts b/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts
index a9435b26d..52127ce8f 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts
@@ -12,4 +12,20 @@
 / {
 	model = "Bluejay";
 	compatible = "google,gs101-bluejay", "google,gs101";
+
+	thermal_sensors: thermal-sensors {
+		compatible = "google,gs101-acpm-thermal";
+		samsung,acpm = <&acpm_ipc>;
+		samsung,acpm-channel = <9>;
+		#thermal-sensor-cells = <1>;
+	};
+
+	thermal-zones {
+		cpu-big-thermal { polling-delay-passive = <250>; polling-delay = <1000>; thermal-sensors = <&thermal_sensors 0>; };
+		cpu-mid-thermal { polling-delay-passive = <250>; polling-delay = <1000>; thermal-sensors = <&thermal_sensors 1>; };
+		cpu-little-thermal { polling-delay-passive = <250>; polling-delay = <1000>; thermal-sensors = <&thermal_sensors 2>; };
+		gpu-thermal { polling-delay-passive = <250>; polling-delay = <1000>; thermal-sensors = <&thermal_sensors 3>; };
+		isp-thermal { polling-delay-passive = <250>; polling-delay = <1000>; thermal-sensors = <&thermal_sensors 4>; };
+		tpu-thermal { polling-delay-passive = <250>; polling-delay = <1000>; thermal-sensors = <&thermal_sensors 5>; };
+	};
 };
