 	 * Take it over ourselves: tell the DWC core not to install its dedicated
@@ -299,8 +360,215 @@
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to request PCIe IRQ\n");
 
+	if (pcie->ch_num >= 0)
