maintainer="Ingo Reitz <9l@9lo.re>"
pkgname=linux-postmarketos-gs101
pkgver=7.0.6
pkgrel=42
pkgdesc="Google gs101 (Pixel 6 Series) close-to-mainline kernel"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-gs101"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bison
	clang
	findutils
	flex
	lld
	llvm
	lz4
	openssl-dev
	perl
	zstd
"

# Source
_commit="d28cfa4275b95e93f4b7a1e743de31b723bd21b8"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/gs101-mainline/linux/archive/$_commit.tar.gz
	$_config
	0001-drm-panfrost-add-mali-g78.patch
	0002-drm-panfrost-log-gpu-capability-registers.patch
	0003-arm64-dts-gs101-mark-gpu-dma-coherent.patch
	0004-clk-gs101-add-hsi1.patch
	0005-phy-gs101-add-pcie.patch
	0006-pci-gs101-add-root-complex.patch
	0007-drm-sysfb-clip-damage-to-scanout.patch
	0010-arm64-dts-gs101-add-max77759-fuel-gauge.patch
	0011-arm64-dts-gs101-add-bcm4389-bluetooth.patch
	0012-arm64-dts-bluejay-expose-bluetooth-uart.patch
	0013-serial-samsung-support-rts-trigger-level.patch
	0014-serial-samsung-log-bluejay-uart-state.patch
	0015-bluetooth-add-minimal-google-nitrous-power-driver.patch
	0016-arm64-dts-gs101-keep-bluetooth-usi-clock-requested.patch
	0017-bluetooth-tolerate-disallowed-mws-config.patch
	0018-thermal-gs101-add-read-only-acpm-sensors.patch
	0019-drm-panfrost-gs101-enable-acpm-devfreq.patch
	gs101_acpm_thermal.c
	max17042_battery.c
	max17042_battery.h
	max77759_charger.c
	max77759.h
	power-supply-Kconfig
	power-supply-Makefile
	linear_range.h
	linear_ranges.c
"
builddir="$srcdir/linux-$_commit"
_outdir="out"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
	cp "$srcdir/max17042_battery.c" \
		"$builddir/drivers/power/supply/max17042_battery.c"
	cp "$srcdir/max17042_battery.h" \
		"$builddir/include/linux/power/max17042_battery.h"
	cp "$srcdir/max77759_charger.c" \
		"$builddir/drivers/power/supply/max77759_charger.c"
	cp "$srcdir/max77759.h" "$builddir/include/linux/mfd/max77759.h"
	cp "$srcdir/power-supply-Kconfig" \
		"$builddir/drivers/power/supply/Kconfig"
	cp "$srcdir/power-supply-Makefile" \
		"$builddir/drivers/power/supply/Makefile"
	cp "$srcdir/linear_range.h" "$builddir/include/linux/linear_range.h"
	cp "$srcdir/linear_ranges.c" "$builddir/lib/linear_ranges.c"
	cp "$srcdir/gs101_acpm_thermal.c" \
		"$builddir/drivers/thermal/samsung/gs101_acpm_thermal.c"
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot

	make Image.lz4 modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release

	install -Dm644 "$builddir/arch/$_carch/boot/Image.lz4" \
		"$pkgdir/boot/vmlinuz"
}

