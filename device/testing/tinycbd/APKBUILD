# Maintainer: Ingo Reitz <9l@9lo.re>
pkgname=tinycbd
pkgver=0.1
pkgrel=5
pkgdesc="Minimal Shannon S5123 modem boot utility"
url="https://github.com/m8l8th814n-eng/tinycbd"
arch="aarch64"
license="GPL-2.0-only"
options="!check"
builddir="$srcdir"
source="
	tinycbd.c
	tinycbd.initd
	tinycbd-prepare
	bluejay-ril-status
"

build() {
	"$CC" $CFLAGS $CPPFLAGS -Wall -Wextra -o tinycbd "$srcdir/tinycbd.c" $LDFLAGS
}

package() {
	install -Dm755 tinycbd "$pkgdir/usr/bin/tinycbd"
	install -Dm755 "$srcdir/tinycbd-prepare" "$pkgdir/usr/libexec/tinycbd-prepare"
	install -Dm755 "$srcdir/tinycbd.initd" "$pkgdir/etc/init.d/tinycbd"
	install -Dm755 "$srcdir/bluejay-ril-status" "$pkgdir/usr/bin/bluejay-ril-status"
}

