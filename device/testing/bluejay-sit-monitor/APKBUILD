# Maintainer: Bluejay Port <bluejay@example.com>
pkgname=bluejay-sit-monitor
pkgver=0.1
pkgrel=0
pkgdesc="Read-only Samsung SIT traffic monitor for Google Bluejay"
url="https://postmarketos.org"
arch="aarch64"
license="GPL-2.0-only"
options="!check"
source="bluejay-sit-monitor.c"

build() {
	$CC $CFLAGS $CPPFLAGS -Wall -Wextra -Werror \
		-o bluejay-sit-monitor bluejay-sit-monitor.c $LDFLAGS
}

package() {
	install -Dm755 bluejay-sit-monitor \
		"$pkgdir"/usr/bin/bluejay-sit-monitor
}

sha512sums="
