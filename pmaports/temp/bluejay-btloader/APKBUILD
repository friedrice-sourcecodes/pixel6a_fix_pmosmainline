pkgname=bluejay-btloader
pkgver=0.1
pkgrel=2
pkgdesc="Google Bluejay BCM4389 firmware provisioner"
url="https://android.googlesource.com/platform/hardware/interfaces"
arch="aarch64"
license="Apache-2.0"
options="!check"
source="bluejay-btloader.c"

build() {
	$CC $CFLAGS $LDFLAGS -Wall -Wextra -o bluejay-btloader bluejay-btloader.c
}

package() {
	install -Dm755 bluejay-btloader "$pkgdir"/usr/libexec/bluejay-btloader
}

