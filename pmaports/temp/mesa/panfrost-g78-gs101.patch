Subject: [PATCH] panfrost: add Mali-G78 and disable transaction elimination

Mali-G78 on GS101 requires transaction elimination to be disabled to avoid
rendering corruption. Backport the model quirk used by mesa-gs101.

--- a/src/panfrost/model/pan_model.h
+++ b/src/panfrost/model/pan_model.h
@@ -86,2 +86,3 @@ struct pan_model {
      bool no_hierarchical_tiling;
      bool max_4x_msaa;
+      bool no_crc;

--- a/src/panfrost/model/pan_model.c
+++ b/src/panfrost/model/pan_model.c
@@ -78,6 +78,9 @@
                                               MODEL_RATES(2, 4,  32)),
    VALHALL_MODEL(PAN_PROD_ID(9, 0, 3), 0, "G57",    "TNAx", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
                                               MODEL_RATES(2, 4,  32)),
+   VALHALL_MODEL(PAN_PROD_ID(9, 2, 2), 0, "G78",    "TBOx", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),
+                                              MODEL_RATES(2, 4,  32),
+                                              MODEL_QUIRKS( .no_crc = true )),
    VALHALL_MODEL(PAN_PROD_ID(10, 8, 7), 0, "G610",   "TVIx", MODEL_ANISO(ALL),  MODEL_TB_SIZES(32768, 16384),
                                               MODEL_RATES(4, 8,  64)),
    VALHALL_MODEL(PAN_PROD_ID(10, 12, 4), 0, "G310v1",   "TVAx", MODEL_ANISO(ALL),  MODEL_TB_SIZES(16384,  8192),

--- a/src/gallium/drivers/panfrost/pan_resource.c
+++ b/src/gallium/drivers/panfrost/pan_resource.c
@@ -828,6 +828,9 @@ panfrost_should_checksum(const struct panfrost_device *dev,
    unsigned bytes_per_pixel = MAX2(pres->base.nr_samples, 1) *
                               util_format_get_blocksize(pres->base.format);
 
+   if (dev->model->quirks.no_crc)
+      return false;
+
    return pres->base.bind & PIPE_BIND_RENDER_TARGET && panfrost_is_2d(pres) &&
           bytes_per_pixel <= bytes_per_pixel_max &&
           pres->base.last_level == 0 && !(dev->debug & PAN_DBG_NO_CRC);
