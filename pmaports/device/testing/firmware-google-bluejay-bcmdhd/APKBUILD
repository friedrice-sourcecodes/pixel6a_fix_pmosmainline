pkgname=firmware-google-bluejay-bcmdhd
pkgver=1
pkgrel=3
pkgdesc="Google Pixel 6a BCM4389 firmware and bcmdhd kernel module"
url="https://github.com/m8l8th814n-eng/raviole_bcmd_postmarketos"
arch="aarch64"
license="proprietary"
options="!check !strip"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	bcmdhd.ko
	bcmdhd.cal
	bcmdhd_clm.blob
	bcmdhd.conf
	fw_bcmdhd.bin
"

package() {
	install -Dm644 "$srcdir"/bcmdhd.ko \
		"$pkgdir"/usr/lib/modules/7.0.6-gs101/extra/bcmdhd.ko
	install -Dm644 "$srcdir"/fw_bcmdhd.bin \
		"$pkgdir"/lib/firmware/fw_bcmdhd.bin
	install -Dm644 "$srcdir"/bcmdhd.cal \
		"$pkgdir"/lib/firmware/bcmdhd.cal
	install -Dm644 "$srcdir"/bcmdhd_clm.blob \
		"$pkgdir"/lib/firmware/bcmdhd_clm.blob
	install -Dm644 "$srcdir"/bcmdhd.conf \
		"$pkgdir"/usr/lib/modules-load.d/bcmdhd.conf
}

