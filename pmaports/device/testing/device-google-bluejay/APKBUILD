maintainer="Ingo Reitz <9l@9lo.re>"
pkgname=device-google-bluejay
pkgdesc="Google Pixel 6a"
pkgver=6
pkgrel=27
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	bluejay-btloader
	bluez-deprecated
	firmware-google-bluejay-bcmdhd
	firmware-google-bluejay-bluetooth
	libgpiod
	linux-postmarketos-gs101
	mesa-dri-gallium
	mesa-egl
	mesa-gbm
	mesa-gles
	mesa-vulkan-panfrost
	postmarketos-base
	soc-google-gs101
	tinycbd
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	polkit-networkmanager-wheel.rules
	bluejay-power.start
	bluejay-bluetooth.initd
	bluejay-bluetooth.confd
	bluedevilglobalrc
	NetworkManager-bluejay.conf
	bluejay-wifi-low-power
	max77759-charger.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/polkit-networkmanager-wheel.rules \
		"$pkgdir"/etc/polkit-1/rules.d/49-networkmanager-wheel.rules
	install -Dm755 "$srcdir"/bluejay-power.start \
		"$pkgdir"/etc/local.d/bluejay-power.start
	install -Dm755 "$srcdir"/bluejay-bluetooth.initd \
		"$pkgdir"/etc/init.d/bluejay-bluetooth
	install -Dm644 "$srcdir"/bluejay-bluetooth.confd \
		"$pkgdir"/etc/conf.d/bluejay-bluetooth
	install -Dm644 "$srcdir"/bluedevilglobalrc \
		"$pkgdir"/etc/xdg/bluedevilglobalrc
	install -Dm644 "$srcdir"/bluedevilglobalrc \
		"$pkgdir"/etc/skel/.config/bluedevilglobalrc
	install -Dm644 "$srcdir"/NetworkManager-bluejay.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/20-bluejay.conf
	install -Dm755 "$srcdir"/bluejay-wifi-low-power \
		"$pkgdir"/usr/bin/bluejay-wifi-low-power
	install -Dm644 "$srcdir"/max77759-charger.conf \
		"$pkgdir"/etc/modules-load.d/max77759-charger.conf
}

