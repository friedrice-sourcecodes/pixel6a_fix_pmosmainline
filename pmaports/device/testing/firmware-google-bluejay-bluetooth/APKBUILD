pkgname=firmware-google-bluejay-bluetooth
pkgver=1
pkgrel=5
pkgdesc="Google Pixel 6a BCM4389 Bluetooth firmware"
url="https://developers.google.com/android/images"
arch="aarch64"
license="proprietary"
options="!check !strip"
source="BCM.hcd"

package() {
	install -Dm644 "$srcdir"/BCM.hcd \
		"$pkgdir"/lib/firmware/brcm/BCM.hcd
	ln -s BCM.hcd "$pkgdir"/lib/firmware/brcm/BCM4389.hcd
	ln -s BCM.hcd "$pkgdir"/lib/firmware/brcm/BCM4389C1.hcd
	ln -s BCM.hcd "$pkgdir"/lib/firmware/brcm/BCM4349B1.hcd
}

sha512sums="
